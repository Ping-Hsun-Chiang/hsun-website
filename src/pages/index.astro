---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, contact, skills, experience, education } from '../data/site';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order || b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base>
  <!-- Hero -->
  <section>
    <div class="card hero">
      <p class="hello">嗨，我是</p>
      <h1>{profile.name}</h1>
      <p class="role">{profile.title}</p>
      <p class="tagline">{profile.tagline}</p>
      <div class="actions">
        <a class="btn btn-primary" href="#contact">聯絡我</a>
        <a class="btn" href="#projects">看作品</a>
        {profile.resumeUrl && (
          <a class="btn" href={`${import.meta.env.BASE_URL}${profile.resumeUrl.replace(/^\//, '')}`} download>
            下載履歷 PDF
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- 關於我 -->
  <section id="about">
    <div class="card pad">
      <h2 class="section-title">關於我</h2>
      <div class="about">
        {profile.about.map((p) => <p class="about-p">{p}</p>)}
      </div>
    </div>
  </section>

  <!-- 學歷 + 聯絡（左）、技能（右） -->
  <section class="two-col">
    <div class="stack">
      <div id="education" class="card pad">
        <h2 class="section-title">學歷</h2>
        <ol class="edu">
          {
            education.map((e) => (
              <li>
                <div class="edu-head">
                  <h3 class="item-title">
                    {e.school}
                    {e.level && <span class="badge">{e.level}</span>}
                  </h3>
                  <span class="edu-period">{e.period}</span>
                </div>
                {e.degree && <p class="sub">{e.degree}</p>}
              </li>
            ))
          }
        </ol>
      </div>
      <div id="contact" class="card pad contact">
        <h2 class="section-title">聯絡我</h2>
        <p>對我的經歷有興趣，或有合作機會，歡迎與我聯繫！</p>
        <ul class="contact-list">
          {contact.phone && (
            <li>📱 <a href={`tel:${contact.phone.replace(/-/g, '')}`}>{contact.phone}</a></li>
          )}
          {contact.email && (
            <li>📧 <a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          )}
          {contact.location && <li>📍 {contact.location}</li>}
        </ul>
        <div class="actions">
          {contact.github && <a class="btn" href={contact.github} target="_blank" rel="noopener">GitHub</a>}
          {contact.linkedin && <a class="btn" href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
        </div>
      </div>
    </div>
    <div class="card pad">
      <h2 class="section-title">技能</h2>
      <div class="skills">
        {
          skills.map((s) => (
            <div class="skill-row">
              <h3 class="skill-cat">{s.category}</h3>
              <div class="tags">{s.items.map((i) => <span class="tag">{i}</span>)}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 經歷 -->
  <section id="experience">
    <h2 class="section-title">經歷</h2>
    <div class="card pad">
      <ol class="timeline">
        {
          experience.map((e) => (
            <li>
              <div class="period">{e.period}</div>
              <div>
                <h3 class="item-title">{e.org}</h3>
                <p class="sub">{e.title}</p>
                <p class="desc">{e.desc}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 專案 -->
  <section id="projects">
    <h2 class="section-title">專案作品</h2>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>

<style>
  .pad {
    padding: 24px 26px;
  }
  .hero {
    padding: 48px 40px;
    background:
      radial-gradient(circle at 100% 0%, var(--accent-soft), transparent 55%),
      var(--surface);
  }
  .hello {
    margin: 0;
    color: var(--muted);
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 2.8rem);
    line-height: 1.25;
  }
  .role {
    margin: 4px 0 12px;
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--accent);
  }
  .tagline {
    margin: 0 0 24px;
    color: var(--muted);
    max-width: 36em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .two-col {
    display: grid;
    grid-template-columns: 4fr 5fr;
    gap: 20px;
    /* 緊接在關於我下方，縮小區塊間距 */
    padding-top: 0;
  }
  /* 內文左右額外留白，標題位置不變 */
  .about {
    padding: 0 40px;
  }
  .about-p {
    margin: 0 0 10px;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .edu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .edu .item-title {
    font-size: 0.98rem;
  }
  .edu-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: 12px;
  }
  .edu-period {
    color: var(--muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .skills {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .skill-row {
    display: grid;
    grid-template-columns: 9em 1fr;
    gap: 12px;
    align-items: baseline;
  }
  .skill-cat {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
    font-weight: 500;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline > li {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px dashed var(--border);
  }
  .timeline > li:first-child {
    padding-top: 0;
  }
  .timeline > li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .period {
    color: var(--muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    padding-top: 2px;
  }
  .item-title {
    margin: 0;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .badge {
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0 8px;
    border-radius: 6px;
    border: 1px solid var(--border);
    color: var(--muted);
  }
  .sub {
    margin: 0;
    color: var(--accent);
    font-size: 0.92rem;
    font-weight: 500;
  }
  .desc {
    margin: 4px 0 0;
    font-size: 0.95rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }

  .contact p {
    margin: 0 0 16px;
    color: var(--muted);
  }
  .contact-list {
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  /* 聯絡資訊維持一般文字顏色，不另外標色 */
  .contact-list a {
    color: inherit;
  }

  @media (max-width: 760px) {
    .two-col {
      grid-template-columns: 1fr;
    }
    .skill-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .about {
      padding: 0;
    }
    .hero {
      padding: 32px 24px;
    }
    .timeline > li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
