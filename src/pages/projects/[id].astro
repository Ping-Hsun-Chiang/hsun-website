---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatMonth } from '../../utils/project';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, subtitle, summary, date, tags, cover, github, demo, paper } = project.data;
const isPrivate = project.data.private;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL;
---

<Base title={title} description={summary}>
  <section>
    <a class="back" href={`${base}#projects`}>← 回到專案列表</a>
    <article class="card">
      {cover && <img class="cover" src={`${base}${cover.replace(/^\//, '')}`} alt={title} />}
      <div class="pad">
        <h1>{title}</h1>
        {subtitle && <p class="subtitle">{subtitle}</p>}
        <div class="meta">
          <span>{formatMonth(date)}</span>
          {isPrivate && <span class="badge">私人專案・原始碼未公開</span>}
          <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>
        </div>
        {
          (github || demo || paper) && (
            <div class="actions">
              {paper && <a class="btn btn-primary" href={paper} target="_blank" rel="noopener">論文全文 ↗</a>}
              {demo && <a class="btn btn-primary" href={demo} target="_blank" rel="noopener">線上 Demo ↗</a>}
              {github && <a class="btn" href={github} target="_blank" rel="noopener">GitHub 原始碼 ↗</a>}
            </div>
          )
        }
        <div class="prose">
          <Content />
        </div>
      </div>
    </article>
  </section>
</Base>

<style>
  .back {
    display: inline-block;
    margin-bottom: 14px;
    color: var(--muted);
    font-size: 0.92rem;
  }
  article {
    overflow: hidden;
    max-width: 780px;
  }
  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .pad {
    padding: 32px 36px 36px;
  }
  h1 {
    margin: 0 0 6px;
    font-size: clamp(1.6rem, 5vw, 2.1rem);
    line-height: 1.3;
  }
  .subtitle {
    margin: 0 0 16px;
    color: var(--muted);
  }
  .badge {
    font-size: 0.78rem;
    padding: 0 8px;
    border-radius: 6px;
    border: 1px solid var(--border);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    font-size: 0.9rem;
    color: var(--muted);
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }
  .prose :global(h2) {
    font-size: 1.2rem;
    margin: 28px 0 8px;
  }
  .prose :global(p),
  .prose :global(li) {
    font-size: 0.98rem;
  }
  .prose :global(ul) {
    padding-left: 1.3em;
  }
  .prose :global(img) {
    border-radius: 10px;
    border: 1px solid var(--border);
  }
  .prose :global(code) {
    background: var(--accent-soft);
    padding: 1px 6px;
    border-radius: 5px;
    font-size: 0.9em;
  }
  @media (max-width: 600px) {
    .pad {
      padding: 24px 20px 28px;
    }
  }
</style>
