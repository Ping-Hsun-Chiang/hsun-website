---
import type { CollectionEntry } from 'astro:content';
import { formatMonth } from '../utils/project';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, subtitle, summary, date, tags, cover, featured } = project.data;
const isPrivate = project.data.private;
const base = import.meta.env.BASE_URL;
const href = `${base}projects/${project.id}/`;
---

<a class:list={['card', 'project', { featured }]} href={href}>
  {cover && <img class="cover" src={`${base}${cover.replace(/^\//, '')}`} alt={title} loading="lazy" />}
  <div class="body">
    <div class="meta">
      <span>{formatMonth(date)}</span>
      {featured && <span class="badge pin">置頂</span>}
      {isPrivate && <span class="badge">私人專案</span>}
    </div>
    <h3>{title}</h3>
    {subtitle && <p class="subtitle">{subtitle}</p>}
    <p class="summary">{summary}</p>
    <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>
  </div>
</a>

<style>
  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: var(--text);
    transition: transform 0.15s, border-color 0.15s;
  }
  .project:hover {
    text-decoration: none;
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .cover {
    aspect-ratio: 16 / 9;
    width: 100%;
    object-fit: cover;
    border-bottom: 1px solid var(--border);
  }
  .body {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }
  .badge {
    font-size: 0.72rem;
    padding: 0 8px;
    border-radius: 6px;
    border: 1px solid var(--border);
  }
  .pin {
    border-color: var(--accent);
    color: var(--accent);
  }
  h3 {
    margin: 0;
    font-size: 1.05rem;
  }
  .subtitle {
    margin: -4px 0 2px;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .summary {
    margin: 0 0 4px;
    color: var(--muted);
    font-size: 0.92rem;
    flex: 1;
  }

  /* 置頂專案：橫跨整列；有封面圖時桌機左圖右文 */
  .featured {
    grid-column: 1 / -1;
  }
  @media (min-width: 761px) {
    .featured {
      flex-direction: row;
    }
    .featured .cover {
      width: 40%;
      aspect-ratio: auto;
      min-height: 240px;
      border-bottom: none;
      border-right: 1px solid var(--border);
    }
    .featured .body {
      padding: 24px 28px;
    }
    .featured h3 {
      font-size: 1.25rem;
    }
  }
</style>
